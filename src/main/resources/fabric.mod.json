{
	"schemaVersion": 1,
	"id": "tweakswitch",
	"version": "${version}",
	"name": "TweakSwitch",
	"description": "On/off switches for resource packs, with in-game downloads from Vanilla Tweaks and Modrinth, previews, and updates.",
	"authors": [
		"kyle"
	],
	"contact": {
		"homepage": "https://github.com/Kyle-15/TweakSwitch",
		"sources": "https://github.com/Kyle-15/TweakSwitch",
		"issues": "https://github.com/Kyle-15/TweakSwitch/issues"
	},
	"license": "MIT",
	"icon": "assets/tweakswitch/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.tweakswitch.TweakSwitch"
		],
		"modmenu": [
			"com.tweakswitch.ModMenuIntegration"
		]
	},
	"mixins": [
		"tweakswitch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
